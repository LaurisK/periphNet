// J-Link script to flash PeriphNet firmware to STM32F407VET6
// Usage: JLinkExe -device STM32F407VE -if SWD -speed 4000 -CommanderScript flash_jlink.jlink

// Connect to target
si SWD
speed 4000
device STM32F407VE

// Reset and halt target
r
h

// Erase flash
erase

// Load firmware
loadfile build/PeriphNet.bin 0x08000000

// Verify
verifybin build/PeriphNet.bin 0x08000000

// Reset and run
r
go

// Exit
exit
